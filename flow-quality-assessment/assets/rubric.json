{
  "scale_labels": {
    "1": "Not Ready",
    "2": "Partially Ready",
    "3": "Baseline",
    "4": "Strong",
    "5": "Superb"
  },
  "level_colors": {
    "1": "#C0392B",
    "2": "#D98C2B",
    "3": "#E8C13F",
    "4": "#6FA84C",
    "5": "#2E6B1F"
  },
  "brand_color": "#820AD1",
  "cut_threshold": 3,
  "aggregation": "simple_mean",
  "quadrants": {
    "star":        { "label": "Star",        "magic": "up",   "value": "up",   "reading": "Alto valor estratégico + alta qualidade de craft. Os fluxos ideais." },
    "hidden_gem":  { "label": "Hidden Gem",  "magic": "down", "value": "up",   "reading": "Alto valor, craft baixo hoje. Fortes candidatos a melhoria/investimento." },
    "table_stakes":{ "label": "Table Stakes","magic": "up",   "value": "down", "reading": "Craft forte, valor relativo menor. Pedem manutenção, não grande investimento novo." },
    "skip":        { "label": "Skip",        "magic": "down", "value": "down", "reading": "Baixo valor e baixo craft. Repensar, simplificar ou despriorizar." }
  },
  "pillars": {
    "craft": {
      "name": "Craft",
      "axis": "x",
      "axis_label": "Magic",
      "scale": [1, 2, 3, 4, 5],
      "parameters": [
        "Navigation & Flow Logic",
        "Performance & Resilience",
        "Interaction, Motion & Feedback",
        "Layout & Surface Craft",
        "Brand & Content Compliance",
        "Smart & Personal"
      ]
    },
    "user_experience_impact": {
      "name": "User Experience Impact",
      "axis": "y",
      "axis_label": "Customer Value",
      "scale": [1, 2, 3, 4, 5],
      "requires_input": "jtbds",
      "parameters": [
        "JTBD Efficiency",
        "Customer Clarity",
        "Trust"
      ]
    },
    "business_impact": {
      "name": "Business Impact",
      "encoding": "point_size",
      "scale": [1, 3, 5],
      "requires_input": "business_metrics",
      "level_labels": {
        "1": "Target missed",
        "3": "Meets target",
        "5": "Stretch"
      },
      "rule": {
        "1": "reported < target",
        "3": "reported >= target and reported < stretch",
        "5": "reported >= stretch"
      },
      "parameter": "Metrics under the \"Demand\" category"
    }
  }
}
